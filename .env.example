# Copy to .env for local dev. On Cloudflare Pages, set these under
# Settings → Environment variables (both Production and Preview).

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional. Server-side only (Pages Function). Enables the "Search YouTube"
# fallback when a song isn't in the catalog. For local Functions dev, put it
# in .dev.vars instead (wrangler reads that file).
YOUTUBE_API_KEY=
